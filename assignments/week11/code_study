#The main function of the game is a while loop and repeats three major steps: Draw, Check, Update.
#Every single frame, it clears the screen and redraws everything from back to front so you see it smoothly: The background image, the hazards and collectibles (spikes, plants, diamonds), the tiles of the world map and UI screens (like the title screen or the "Game Won" screen).
#Then it uses variables (True/False flags) to decide what should be happening right now: If game_started is False: It blocks the game and only shows the main menu splash screen and the "Play" button, if game_won is True: It freezes the game and displays the victory image and if playing normally: It displays the movement controls overlay.
#Inside the while loop there is a MOUSEBUTTONDOWN AND MOUSEBUTTONUP inside a for loop that serves for handling input and events inside the game.
for event in pygame.event.get():
    if event.type == pygame.QUIT:
        running = False

    if event.type == pygame.MOUSEBUTTONDOWN:
        pos = event.pos
        if show_keys:
            if dir_dict["Up"].collidepoint(pos):
                pressed_keys[0] = True
            if dir_dict["Down"].collidepoint(pos):
                pressed_keys[1] = True
            if dir_dict["Left"].collidepoint(pos):
                pressed_keys[2] = True
            if dir_dict["Right"].collidepoint(pos):
                pressed_keys[3] = True

    if event.type == pygame.MOUSEBUTTONUP:
        pressed_keys = [False, False, False, False]

#Lastly, if the game isn't over, it passes those pressed_keys to the player to move them around and check if they hit spikes (which sets game_over = True).
#It checks if the player touched the portal. If they did: If there are more levels left, it clears the old map, loads Level 2 or 3, and resets the player and if they beat the maximum level, it sets game_won = True.
#Example from the code:
        if not game_over:
		    game_over = player.update(pressed_keys, game_over)
			if game_over:
				show_keys = False
				replay_menu = True

		if player.rect.colliderect(portal) and player.rect.top > portal.rect.top and player.rect.bottom < portal.rect.bottom:
			if current_level < MAX_LEVEL:
				current_level += 1
				for group in groups:
					group.empty()

				data = load_level(current_level)
				(player_x, player_y), (portal_x, portal_y) = game_data(current_level)

				world = World(win, data, groups)
				player = Player(win, (player_x,player_y), world, groups)
				portal = Portal(portal_x, portal_y, win)
			else:
				show_keys = False
				game_won = True
#The game uses a replay menu, where if game_over is true it offers you the options: Quit, Sound and Replay, where clicking replay resets the current level entirely so you can try again.
if replay_menu:
    if quit_btn.draw(win):
        running = False

    if sound_btn.draw(win):
        sound_on = not sound_on

        if sound_on:
            sound_btn.update_image(sound_on_img)
            pygame.mixer.music.play(loops=-1)
        else:
            sound_btn.update_image(sound_off_img)
            pygame.mixer.music.stop()

    if replay_btn.draw(win):
        show_keys = True
        replay_menu = False
        game_over = False
        replay_fx.play()

